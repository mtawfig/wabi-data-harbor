# /opt/wabi-insight/.env — the settings of the Docker stack (docs/DEPLOYMENT_LINUX_DOCKER.md, step 17).
# `wabi-docker install` creates this file once and fills the two generated secrets; you fill the first two lines.
# Mode 600: only root can read it. Never commit it, never paste it into a chat or e-mail.

# The site's address, without https:// (a DNS A record must point it at this server: step 3).
WI_DOMAIN=insight.example.com
# Let's Encrypt sends certificate notices here.
WI_ACME_EMAIL=it@example.com

# Where the images come from: GitHub's container registry of the repository owner (lower case).
WI_REGISTRY=ghcr.io/mtawfig

# SQL Server's administrator (sa) password. Generated by `wabi-docker install`; used only by wabi-docker itself.
# Change it only before the first `wabi-docker init`: SQL Server keeps the password it started with.
WI_SA_PASSWORD=
# SQL Server edition: Express is free (10 GB per database). Do not use Developer in production.
WI_MSSQL_EDITION=Express

# Backups (step 32). The passphrase encrypts every backup file. Generated by `wabi-docker install`.
# STORE IT IN YOUR PASSWORD MANAGER: without it no backup can be restored, on this server or another one.
WI_BACKUP_PASSPHRASE=
# Optional: the SAS URL of an Azure Blob container for off-server copies (step 33), for example
# https://<account>.blob.core.windows.net/wabi-backups?sv=...&sig=...   (empty = backups stay on this server only)
WI_BACKUP_SAS_URL=
# How many backups to keep on this server (each night makes one).
WI_BACKUP_KEEP=7

# Leave empty. Set to local_certs only while testing a copy on a new server before DNS points at it (step 46):
# Caddy then uses its own certificate (browsers warn) instead of Let's Encrypt. Empty it again at step 47.
WI_CADDY_OPTIONS=
