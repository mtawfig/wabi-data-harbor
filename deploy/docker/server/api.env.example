# /opt/wabi-insight/api.env — the application's settings (docs/DEPLOYMENT_LINUX_DOCKER.md, step 19).
# Read by the API container. Mode 600: only root can read it. Never commit it, never paste it into a chat or e-mail.
#
# One setting per line: Section__Key=value (two underscores between the parts; no quotes, no spaces around "=").
# Anything set here overrides appsettings.json in the image. Lines starting with # are ignored.
# After a change: sudo wabi-docker restart

# The configuration database. Filled in by `wabi-docker init` (step 20); leave it empty before that.
ConnectionStrings__ConfigurationDatabase=

# Files (reports, exports, attachments, logos): in Azure Blob Storage (step 18) or on this server (FileSystem, the default):
Storage__Provider=FileSystem
# Storage__Provider=AzureBlob
# Storage__AzureBlob__ConnectionString=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
# Storage__AzureBlob__ContainerName=wabi-insight-files
# Storage__AzureBlob__ReadFromDiskWhenMissing=false

# The read-only login for Platform Insights. Filled in by `wabi-docker insights-login` (step 29).
Insights__ConnectionString=

# Optional: your own e-mail server and AI key instead of the ones in appsettings.json.
# Email__Host=smtp.example.com
# Email__Port=587
# Email__UserName=no-reply@example.com
# Email__Password=<password>
# Email__FromEmail=no-reply@example.com
# Ai__Anthropic__ApiKey=<key>
