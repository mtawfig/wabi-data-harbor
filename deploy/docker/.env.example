# Copy to .env next to docker-compose.prod.yml. Never commit the real file.
WI_BASE_URL=https://insight.example.com
WI_DB_CONNECTION=Server=sqlserver,1433;Database=WabiInsightDB;User Id=wabiinsight;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True;
WI_SA_PASSWORD=CHANGE_ME_Strong#Pass1
WI_MSSQL_EDITION=Express
WI_SMTP_HOST=smtp.example.com
WI_SMTP_PORT=465
WI_SMTP_USER=no-reply@example.com
WI_SMTP_PASSWORD=CHANGE_ME
WI_SMTP_FROM=no-reply@example.com
WI_ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
# First start only: create the first Platform Administrator, then set WI_BOOTSTRAP_ENABLED=false.
WI_BOOTSTRAP_ENABLED=false
WI_BOOTSTRAP_EMAIL=
WI_BOOTSTRAP_PASSWORD=
WI_BOOTSTRAP_SECRET=
# None | ClamAv (start the stack with --profile scanner)
WI_SCANNER=None
