<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS deployment of the API (ASP.NET Core Module v2, in-process). Publish with
  `dotnet publish src/WabiInsight.Api -c Release -o C:\wabitex-apps\wabi-insight\web\api` and copy this file next to
  WabiInsight.Api.dll. Secrets are set as environment variables on the application pool (or in
  appsettings.Local.json with restricted ACLs) — never in this file.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\WabiInsight.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- 12 MB: ticket attachments (10 MB) plus multipart overhead; the API enforces its own limits as well. -->
          <requestLimits maxAllowedContentLength="12582912" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
