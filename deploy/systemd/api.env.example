# /etc/wabi-insight/api.env (chmod 600). Double underscores map to configuration sections.
ConnectionStrings__ConfigurationDatabase=Server=sql.internal,1433;Database=WabiInsightDB;User Id=wabiinsight;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True;
Platform__BaseUrl=https://insight.example.com
Storage__RootPath=/var/lib/wabi-insight/artifacts
DataProtection__KeyRingPath=/var/lib/wabi-insight/keys
Email__Provider=Smtp
Email__Host=smtp.example.com
Email__Port=465
Email__EnableSsl=true
Email__UserName=no-reply@example.com
Email__Password=CHANGE_ME
Email__FromEmail=no-reply@example.com
Ai__Anthropic__ApiKey=sk-ant-CHANGE_ME
AttachmentScanning__Provider=None
Bootstrap__Enabled=false
